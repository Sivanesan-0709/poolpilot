# Database URL (Optional: defaults to SQLite data/poolpilot.db locally, or /tmp/poolpilot.db in serverless)
# Supports PostgreSQL on Neon / Supabase:
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Serverless Simulation Toggle (1 = simulate serverless /tmp database & polling on localhost)
POOLPILOT_SERVERLESS=0

# AI Model Flags (1 = enabled with instant fallback if dependencies not installed)
ENABLE_CHRONOS_DEMAND=1
ENABLE_VOICE_BOOKING=1
ENABLE_EASYOCR=1
ENABLE_FACEMATCH=1
ENABLE_SEMANTIC_SEARCH=1
